# Server-only settings. Never commit real values.
# Supabase Dashboard -> Project Settings -> API.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Protect the private definitions catalogue in the website.
KAVACH_DASHBOARD_PASSWORD=replace-with-a-long-unique-password
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
KAVACH_SESSION_SECRET=replace-with-a-long-random-secret
